{
  "name": "romper",
  "description": "Cross-platform sample manager for Squarp Rample Eurorack sampler",
  "author": "Romper Development Team",
  "license": "MIT",
  "private": true,
  "version": "1.3.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/peteb4ker/romper.git"
  },
  "type": "module",
  "main": "dist/electron/main/index.js",
  "scripts": {
    "build": "concurrently -n main,preload,renderer \"npm run build:main\" \"npm run build:preload\" \"npm run build:renderer\"",
    "build:main": "vite build --config vite.main.config.ts",
    "build:preload": "tsc -p electron/preload/tsconfig.preload.json && mv dist/electron/preload/index.js dist/electron/preload/index.cjs",
    "build:renderer": "vite build --config vite.config.ts",
    "make": "npm run build && electron-forge make",
    "package": "npm run build && electron-forge package",
    "publish": "npm run build && electron-forge release",
    "test": "bash -c 'npm run test:unit; u=$?; npm run test:integration; i=$?; npm run coverage:merge; npm run coverage:total; exit $(( u || i ))'",
    "test:unit": "npx vitest --config vite.config.ts --run --silent --reporter=dot",
    "test:integration": "node electron/run-vitest-in-electron.cjs --run --silent --reporter=dot",
    "test:fast": "bash -c 'npm run test:unit:fast; u=$?; npm run test:integration:fast; i=$?; exit $(( u || i ))'",
    "test:unit:fast": "npx vitest --config vitest.config.fast.ts --run --silent --reporter=dot",
    "test:integration:fast": "node electron/run-vitest-fast-in-electron.cjs --run --silent --reporter=dot",
    "test:e2e": "npm run build && npm run test:play",
    "test:e2e:headed": "npm run build && cross-env ROMPER_HEADLESS=false playwright test",
    "test:play": "playwright test",
    "validate:full": "node scripts/validate-full.mjs",
    "trace": "node scripts/traceability.mjs",
    "trace:check": "node scripts/traceability.mjs --check",
    "fixtures:e2e": "npm run build && node scripts/generate-e2e-fixtures-from-wizard.mjs",
    "coverage:merge": "npm run coverage:merge:json && npm run coverage:merge:lcov",
    "coverage:merge:json": "mkdir -p coverage/merged && istanbul-merge --out coverage/merged/coverage-final.json coverage/unit/coverage-final.json coverage/integration/coverage-final.json",
    "coverage:merge:lcov": "mkdir -p coverage/merged && lcov -q -a coverage/unit/lcov.info -a coverage/integration/lcov.info --output-file coverage/merged/lcov.info",
    "coverage:total": "nyc report --temp-dir=coverage/merged --reporter=text-summary",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "lint:check": "eslint . --ext .js,.jsx,.ts,.tsx",
    "dev": "node scripts/dev.js",
    "electron:dev": "NODE_ENV=development electron --inspect=5858 --remote-debugging-port=9229 dist/electron/main/index.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "pre-commit": "concurrently --kill-others-on-fail -n tsc,lint,test,build \"npm run typecheck\" \"npm run lint:check\" \"npm run test:husky\" \"npm run build\"",
    "test:husky": "npm run test:unit:husky && npm run test:integration:husky",
    "test:unit:husky": "NO_COLOR=true npm run test:unit:fast",
    "test:integration:husky": "NO_COLOR=true npm run test:integration:fast",
    "prepare": "husky",
    "worktree:create": "node scripts/worktree-create.js",
    "worktree:list": "git worktree list",
    "worktree:remove": "node scripts/worktree-remove.js",
    "worktree:current": "node scripts/worktree-current.js",
    "pre-release": "node scripts/release/validate.js",
    "icons:generate": "node scripts/generate-app-icons.mjs",
    "dmg:background:generate": "node scripts/generate-dmg-background.mjs",
    "screenshots": "tsx scripts/capture-screenshots.ts"
  },
  "devDependencies": {
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-deb": "^8.0.1",
    "@electron-forge/maker-dmg": "^8.0.1",
    "@electron-forge/maker-rpm": "^8.0.1",
    "@electron-forge/maker-squirrel": "^8.0.1",
    "@electron-forge/maker-zip": "^8.0.1",
    "@electron-forge/plugin-fuses": "^8.0.1",
    "@electron/fuses": "^2.1.3",
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/archiver": "^6.0.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^24.3.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-window": "^1.8.8",
    "@types/tar": "^6.1.13",
    "@typescript-eslint/parser": "^8.71.0",
    "@typescript-eslint/typescript-estree": "^8.71.0",
    "@vitest/coverage-v8": "^5.0.3",
    "adm-zip": "^0.6.1",
    "archiver": "^7.0.1",
    "autoprefixer": "^10.6.1",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^44.5.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-perfectionist": "^4.15.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-sonarjs": "^4.2.2",
    "fast-check": "^4.10.2",
    "fontkit": "^2.0.4",
    "globals": "^16.3.0",
    "handlebars": "^4.7.9",
    "husky": "^9.1.7",
    "istanbul-merge": "^2.0.0",
    "jsdom": "^26.1.0",
    "lcov": "^1.16.0",
    "node-gyp": "^13.0.2",
    "nyc": "^18.0.0",
    "playwright": "^1.56.1",
    "rollup": "^4.63.6",
    "sharp": "^0.35.5",
    "sonarqube-scanner": "^5.0.1",
    "tailwindcss": "^4.1.8",
    "tar": "^7.5.22",
    "tsx": "^4.23.15",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "eslint": "^10.12.0",
    "serialize-javascript": "^7.0.5",
    "minimatch@>=10.0.0": "10.2.4",
    "tar": "^7.5.22",
    "shell-quote": "^1.10.0",
    "@electron/node-gyp": "npm:node-gyp@^13.0.2"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@tailwindcss/vite": "^4.3.3",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@vitejs/plugin-react": "^6.1.1",
    "better-sqlite3": "^13.0.3",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.3",
    "lightningcss": "^1.33.0",
    "prebuildify": "^6.0.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-dropzone": "^20.1.2",
    "react-router-dom": "^7.18.4",
    "react-window": "^1.8.11",
    "unzipper": "^0.12.5",
    "update-electron-app": "^3.3.0",
    "wavesurfer.js": "^7.9.5"
  }
}
